<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_ecowaste_brand"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_ecowaste_brand"
        android:supportsRtl="true"
        android:theme="@style/Theme.Yawmeyaty">
        <activity android:name=".EcoWasteActivity" android:exported="false" />
        <activity android:name=".EcoWastePhoneActivity" android:exported="true" />
        <activity android:name=".EcoWasteSubscribersActivity" android:exported="false" />
        <activity android:name=".EcoWasteAdminActivity" android:exported="false" />
        <activity android:name=".EcoWasteEntryActivity" android:exported="false" />
        <activity android:name=".EcoWasteModernActivity" android:exported="false" />
        <activity
            android:name=".EcoWasteUpdateGateActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>